{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nongskuy-backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-25",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
	},
	"durable_objects": {
		"bindings": [
			{ "name": "CHAT_ROOM", "class_name": "ChatRoom" },
			{ "name": "USER_LOCATION", "class_name": "UserLocation" },
			{ "name": "GROUP_REGISTRY", "class_name": "GroupRegistry" },
			{ "name": "MEETUP_REGISTRY", "class_name": "MeetupRegistry" },
			{ "name": "TOKEN_REGISTRY", "class_name": "TokenRegistry" },
		],
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["ChatRoom", "UserLocation"] },
		{ "tag": "v2", "new_sqlite_classes": ["GroupRegistry"] },
		{ "tag": "v3", "new_sqlite_classes": ["MeetupRegistry"] },
		{ "tag": "v4", "new_sqlite_classes": ["TokenRegistry"] },
	],
	"kv_namespaces": [
		{
			"binding": "NONGSKUY_FCM_CACHE",
			"id": "1bd75368c6694dd68f2dd888b2d5813d",
		},
	],
	"triggers": {
		"crons": ["0 0 * * *"],
	},
}
